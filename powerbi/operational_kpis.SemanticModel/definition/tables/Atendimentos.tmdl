table Atendimentos
	lineageTag: de226012-849a-4151-adb3-18d1feb27370

	measure 'Total de atendimentos' = COUNTROWS(Atendimentos)
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: 2a21689c-f7eb-4107-b29a-43696b4c3192

	measure Resolvidos = CALCULATE([Total de atendimentos], Atendimentos[resolvido] = 1)
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: 7ebb74aa-b8f6-4a2a-8316-9ed1d3b4ac93

	measure 'Dentro do SLA' = SUM(Atendimentos[dentro_sla])
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: a2a35a23-b195-4058-9535-7488bc20cb39

	measure SLA = DIVIDE([Dentro do SLA], [Total de atendimentos])
		formatString: 0.00%
		displayFolder: Indicadores
		lineageTag: 3d8680a5-56e7-443e-b535-357097b6f1af

	measure 'SLA dos resolvidos' = DIVIDE([Dentro do SLA], [Resolvidos])
		formatString: 0.00%
		displayFolder: Indicadores
		lineageTag: dc1bcca8-a110-4df2-b23f-c1269e76e94b

	measure FCR = DIVIDE(SUM(Atendimentos[resolvido_primeiro_contato]), [Resolvidos])
		formatString: 0.00%
		displayFolder: Indicadores
		lineageTag: b549b829-0e86-4ad2-a1b7-ecf84b1c924d

	measure 'Cobertura FCR' = DIVIDE(COUNT(Atendimentos[resolvido_primeiro_contato]), [Resolvidos])
		formatString: 0.00%
		displayFolder: Indicadores
		lineageTag: f9d99ac4-8eae-485f-a957-6ffc43bb5834

	measure 'Tempo médio de resolução' = CALCULATE(AVERAGE(Atendimentos[tempo_resolucao_horas]), Atendimentos[resolvido] = 1)
		formatString: 0.00
		displayFolder: Indicadores
		lineageTag: 8b08058f-587b-4761-84f0-c7a58370ff73

	measure Backlog = CALCULATE([Total de atendimentos], Atendimentos[resolvido] = 0)
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: 51369402-ce25-4932-9a57-e726075c35a0

	measure 'Pendentes vencidos' = SUM(Atendimentos[pendente_vencido])
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: 0b1a3b06-eefe-4596-96ce-699e3c51c0e5

	measure CSAT = CALCULATE(AVERAGE(Atendimentos[nota_satisfacao]), Atendimentos[resolvido] = 1)
		formatString: 0.00
		displayFolder: Indicadores
		lineageTag: 5a74cef5-98bd-4d68-b325-112b35943b9b

	measure 'Respostas CSAT' = CALCULATE(COUNT(Atendimentos[nota_satisfacao]), Atendimentos[resolvido] = 1)
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: 85fce682-cc37-4936-879b-c70dec37e620

	measure 'Cobertura CSAT' = DIVIDE([Respostas CSAT], [Resolvidos])
		formatString: 0.00%
		displayFolder: Indicadores
		lineageTag: 41af0900-261a-46da-a91d-e4837cc92b1b

	measure Produtividade = [Resolvidos]
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: fa2200b3-fde4-46a4-8a2a-77e4325014ce

	measure 'Taxa de resolução' = DIVIDE([Resolvidos], [Total de atendimentos])
		formatString: 0.00%
		displayFolder: Indicadores
		lineageTag: aaf7a2e7-718a-4738-8721-535f7943c5dc

	measure 'Backlog histórico' =
			VAR Limite = MAX(Calendario[data]) + 1
			RETURN
			    CALCULATE(
			        COUNTROWS(Atendimentos),
			        REMOVEFILTERS(Calendario),
			        REMOVEFILTERS(Atendimentos[Data abertura]),
			        REMOVEFILTERS(Atendimentos[mes_abertura]),
			        FILTER(
			            ALL(Atendimentos[data_abertura], Atendimentos[data_fechamento]),
			            Atendimentos[data_abertura] < Limite
			                && (ISBLANK(Atendimentos[data_fechamento])
			                    || Atendimentos[data_fechamento] >= Limite)
			        )
			    )
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: 20e3c7ee-fdbc-422b-a811-29078b1a6da2

