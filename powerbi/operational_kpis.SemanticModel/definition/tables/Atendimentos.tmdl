	partition Atendimentos = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "atendimentos.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Vazios = Table.ReplaceValue(Cabecalhos, "", null, Replacer.ReplaceValue, Table.ColumnNames(Cabecalhos)),
				    Tipos = Table.TransformColumnTypes(Vazios, {{"id_atendimento", Int64.Type}, {"id_cliente", Int64.Type}, {"data_abertura", type datetime}, {"data_fechamento", type datetime}, {"canal", type text}, {"categoria", type text}, {"subcategoria", type text}, {"prioridade", type text}, {"equipe", type text}, {"atendente", type text}, {"status", type text}, {"tempo_primeira_resposta_min", type number}, {"tempo_resolucao_horas", type number}, {"dentro_sla", Int64.Type}, {"resolvido_primeiro_contato", Int64.Type}, {"nota_satisfacao", type number}, {"quantidade_interacoes", Int64.Type}, {"resolvido", Int64.Type}, {"sla_horas", Int64.Type}, {"mes_abertura", type text}, {"mes_fechamento", type text}, {"idade_horas", type number}, {"pendente_vencido", Int64.Type}, {"resposta_extrema", Int64.Type}}, "en-US"),
				    Abertura = Table.AddColumn(Tipos, "Data abertura", each Date.From([data_abertura]), type date),
				    Prioridade = Table.AddColumn(Abertura, "Ordem prioridade", each if [prioridade] = "Crítica" then 1 else if [prioridade] = "Alta" then 2 else if [prioridade] = "Média" then 3 else 4, Int64.Type)
				in
				    Prioridade

